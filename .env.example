ENVIRONMENT=development
STORAGE_PATH=./data
DATABASE_URL=sqlite+aiosqlite:///./data/framemind.db
REDIS_URL=redis://localhost:6379/0
CLIP_DEVICE=cpu
MODEL_REVISION=main
FRAME_EXTRACTION_FPS=2
TEMPORAL_FPS=8
TEMPORAL_WINDOW_FRAMES=8
TEMPORAL_STRIDE=0.5
SPATIAL_BATCH_SIZE=32
TEMPORAL_BATCH_SIZE=8
CHUNK_SECONDS=60
DECODE_SIZE=224
PREFETCH_BATCHES=2
INDEX_CACHE_MB=256
MAX_VIDEO_SIZE_MB=20480
USE_TEMPORAL=true
USE_FAISS=true
VLM_PROVIDER=openai
VLM_MODEL=gpt-4o
VLM_API_KEY=
AUTOGAZE_ENABLED=false
AUTOGAZE_URL=
AUTOGAZE_TOKEN=
AUTOGAZE_TIMEOUT=300
VIDEO_MAX_FRAMES=128
VIDEO_MAX_TILES=12
